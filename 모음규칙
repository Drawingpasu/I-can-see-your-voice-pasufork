from hangul import *
# 5항
def 연음(음절들):
    for i in range(len(음절들) - 1):
        앞=음절들[i]
        뒤 = 음절들[i + 1]
 # 1. 다만 2: 'ㅖ' → [ㅔ] 허용 (단, '예', '례'는 제외)
        if 앞['중'] == 'ㅖ':
            if 앞['초'] not in ['ㅇ', 'ㄹ']:
                앞['중'] = 'ㅔ'
 
        # 2. 다만 3: 자음을 첫소리로 가진 음절의 'ㅢ' → [ㅣ] (원칙)
        elif 앞['중'] == 'ㅢ' and 앞['초'] != 'ㅇ':
            앞['중'] = 'ㅣ'
 
        # 3. 다만 4: 뒤 음절이 '의'인 경우
        #    문장 맨 앞의 '의'는 뒤 음절이 될 일이 없으니 자동으로 그대로 [의]
        if i + 1 < len(음절들):
            if 뒤['한글아님'] is None and 뒤['초'] == 'ㅇ' and 뒤['중'] == 'ㅢ':
 
                # 조사 '의': 앞에서 형태소가 끝나고, 다음 형태소가 관형격 조사(JKG)
                if 앞['형태소끝'] and 앞['다음품사'] == 'JKG':
                    뒤['중'] = 'ㅔ'      # 우리의[우리에]
 
                # 어절 첫음절이 아닌 '의': 앞 음절이 어절끝이 아니면
                elif not 앞['어절끝']:
                    뒤['중'] = 'ㅣ'

    return 음절들